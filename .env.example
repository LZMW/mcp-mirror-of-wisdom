# 求知镜 MCP 环境变量配置

# ================================
# LLM API 配置
# ================================

# AI服务提供商 (可选，默认: openai)
# 支持的值: openai, anthropic, zhipu, gemini, custom
MIRROR_PROVIDER=openai

# API密钥 (必需)
# 从对应提供商的开放平台获取
MIRROR_API_KEY=your-api-key-here

# API基础URL (可选，用于代理或自定义端点)
# 例如: https://api.example.com/v1
# MIRROR_BASE_URL=https://api.openai.com/v1

# 模型名称 (可选，默认: gpt-4o-mini)
# OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# 智谱AI: glm-4-flash, glm-4, glm-4-plus
# Gemini: gemini-1.5-pro, gemini-1.5-flash
MIRROR_MODEL=gpt-4o-mini

# ================================
# 生成参数配置
# ================================

# 温度参数 (可选，默认: 0.7)
# 较低的值使输出更确定，较高的值使输出更随机
# MIRROR_TEMPERATURE=0.7

# 最大生成tokens (可选，默认: 4096)
# MIRROR_MAX_TOKENS=4096

# 请求超时时间（秒，可选，默认: 90）
# Phase 3 优化：延长至 90s 以覆盖 72s 的异常值
# MIRROR_TIMEOUT=90

# 最大重试次数（可选，默认: 3）
# MIRROR_MAX_RETRIES=3

# 重试延迟（秒，可选，默认: 1）
# MIRROR_RETRY_DELAY=1

# ================================
# Phase 5: 两阶段提示词优化配置
# ================================

# 约束合并模式（可选，默认: priority）
# 支持的值:
#   - priority: 请求参数优先（请求参数存在时忽略配置）
#   - merge: 叠加模式（配置预设 + 请求参数合并）
# MIRROR_CONSTRAINT_MERGE_MODE=priority

# 全局默认约束条件（可选）
# 格式必须是 Python 列表语法: ["约束1", "约束2", "约束3"]
# 这些约束会自动应用于所有专家提示词生成，合并模式决定如何与请求参数结合
# 示例：
# MIRROR_DEFAULT_CONSTRAINTS=["禁止推荐付费工具", "必须使用中文回复", "代码必须包含类型注解"]
# MIRROR_DEFAULT_CONSTRAINTS=["禁止推荐付费工具", "必须使用中文"]

# 全局默认验收标准（可选）
# 格式必须是 Python 列表语法: ["标准1", "标准2", "标准3"]
# 这些验收标准会自动应用于所有专家提示词生成，合并模式决定如何与请求参数结合
# 示例：
# MIRROR_DEFAULT_EVALUATION=["建议必须具体可执行", "需要提供代码示例", "包含性能考虑"]
# MIRROR_DEFAULT_EVALUATION=["建议必须具体可执行", "需要提供代码示例"]

# ================================
# 服务器配置
# ================================

# 服务器日志级别 (可选，默认: INFO)
# 支持的值: DEBUG, INFO, WARNING, ERROR
# MIRROR_LOG_LEVEL=INFO

# 启用对话历史持久化 (可选，默认: true)
# 设置为 false 可禁用持久化，仅使用内存模式
# MIRROR_ENABLE_PERSISTENCE=true

# 对话历史文件路径 (可选，默认: .mirror-of-wisdom/history.json)
# 支持相对路径或绝对路径
# MIRROR_HISTORY_PATH=.mirror-of-wisdom/history.json

# 对话历史最大保存数（可选，默认: 50）
# MIRROR_MAX_HISTORY=50

# ================================
# 功能开关
# ================================

# 启用角色切换功能 (可选，默认: true)
# MIRROR_ENABLE_ROLE_SWITCHING=true

# 启用配置热重载 (可选，默认: false)
# MIRROR_ENABLE_CONFIG_RELOAD=false

# 启用质量自检 (可选，默认: true)
# MIRROR_ENABLE_QUALITY_CHECK=true

# 质量阈值 (可选，默认: 0.8)
# MIRROR_QUALITY_THRESHOLD=0.8
